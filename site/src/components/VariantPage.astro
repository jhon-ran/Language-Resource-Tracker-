---
// One language variant's page, from src/data/variants/<variant-id>.json.
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, localePath, type Locale, type UiKey } from '../i18n/ui';
import { intlLocale, type VariantDetail } from '../lib/indicators';

interface Props {
  locale: Locale;
  variant: string;
}

const { locale, variant } = Astro.props;
const t = useTranslations(locale);

const files = import.meta.glob<{ default: VariantDetail }>('../data/variants/*.json', { eager: true });
const file = files[`../data/variants/${variant}.json`];
if (!file) throw new Error(`no data file for variant ${variant}`);
const v = file.default;

const number = new Intl.NumberFormat(intlLocale(locale));
const percent = new Intl.NumberFormat(intlLocale(locale), { maximumFractionDigits: 2 });
const gradeLabel = (grade: number) => t(`scatter.grade.${grade}` as UiKey);
const groupHref = localePath(locale, `languages/${v.group.slug}`);

// A figure the source did not give is shown as a dash, never as zero.
const count = (n: number | null) => (n === null ? '—' : number.format(n));
const share = (n: number | null) => (n === null ? '—' : `${percent.format(n)}%`);

const figures = [
  { label: t('var.risk.speakers'), value: count(v.risk.speakers_total) },
  { label: t('var.risk.speakers30'), value: count(v.risk.speakers_30pct_localities) },
  { label: t('var.risk.localities'), value: count(v.risk.localities_total) },
  { label: t('var.risk.localities30'), value: count(v.risk.localities_30pct) },
  { label: t('var.risk.proportion'), value: share(v.risk.speaker_proportion) },
  { label: t('var.risk.children'), value: share(v.risk.child_proportion) },
];

const ipaStatuses = ['extracted', 'corrected-by-hand', 'in-review'] as const;
const loc = v.localities;
---

<BaseLayout locale={locale} path={`languages/${v.group.slug}/${v.variant}`} title={v.spanish_name}>
  <section class="wrap head">
    <nav class="crumbs" aria-label={t('var.back.all')}>
      <a href={localePath(locale, 'languages')}>{t('var.back.all')}</a>
      <span aria-hidden="true">/</span>
      <a href={groupHref}>{v.group.name}</a>
    </nav>
    <h1>{v.spanish_name}</h1>
    <p class="sub">
      <span class="eyebrow">{t('var.variant')}</span>
      <span class="eyebrow">{t('group.family')}</span> {v.family}
    </p>
  </section>

  <section class="wrap facts">
    <div class="card fact">
      <div class="eyebrow">{t('var.risk')}</div>
      <div class="figure word">
        <span class="risk-swatch big" style={`background: var(--risk-${v.risk.grade})`}></span>
        {gradeLabel(v.risk.grade)}
      </div>
      <p class="small">{t('var.risk.short').replace('{year}', String(v.risk.census_year))}</p>
    </div>

    <div class="card fact">
      <div class="eyebrow">{t('var.risk.rank')}</div>
      <div class="figure">{number.format(v.risk.rank)}</div>
    </div>

    <div class="card fact">
      <div class="eyebrow">{t('var.group')}</div>
      <div class="figure word"><a href={groupHref}>{v.group.name}</a></div>
      <dl class="kv">
        <dt>{t('var.glottocode')}</dt>
        <dd>
          {
            v.glottocode.value ? (
              <>
                <span class="mono">{v.glottocode.value}</span>
                <span class="small-inline">{t('var.glottocode.group')}</span>
              </>
            ) : (
              <span class="state-unresolved">{t('var.glottocode.none')}</span>
            )
          }
        </dd>
      </dl>
    </div>
  </section>

  <section class="wrap block">
    <h2>{t('var.autonyms')}</h2>
    <p class="lede">{t('var.autonyms.lede')}</p>
    <div class="card scroller">
      <table>
        <thead>
          <tr>
            <th scope="col">{t('var.col.autonym')}</th>
            <th scope="col">{t('var.col.ipa')}</th>
            <th scope="col">{t('var.col.status')}</th>
          </tr>
        </thead>
        <tbody>
          {
            v.autonyms.map((a) => (
              <tr>
                <th scope="row" class="autonym">
                  {a.autonym}
                  {a.autonym_appendix4 !== a.autonym && (
                    <span class="alt">
                      {t('var.appendix4')}: {a.autonym_appendix4}
                    </span>
                  )}
                </th>
                <td class="ipa">
                  {a.ipa !== null ? (
                    <span class="ipa-text" lang="und-fonipa">{a.ipa}</span>
                  ) : (
                    <span class="state-unresolved">
                      <span aria-hidden="true">?</span>
                      <span class="visually-hidden">{t(`ipa.${a.ipa_status}` as UiKey)}</span>
                    </span>
                  )}
                  {a.ipa_status === 'corrected-by-hand' && <span class="mark" aria-hidden="true">*</span>}
                </td>
                <td class:list={['status', `ipa-${a.ipa_status}`]}>{t(`ipa.${a.ipa_status}` as UiKey)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <dl class="legend">
      <dt>{t('ipa.legend')}</dt>
      {
        ipaStatuses.map((s) => (
          <dd>
            <span class="mono sample">{s === 'extracted' ? '[…]' : s === 'corrected-by-hand' ? '[…]*' : '?'}</span>
            {t(`ipa.${s}` as UiKey)}
          </dd>
        ))
      }
    </dl>
    <p class="font-note">
      <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/licenses/charis-sil-OFL.txt`}>{t('ipa.font')}</a>
    </p>
  </section>

  <section class="wrap block two">
    <div>
      <h2>{t('var.risk')}</h2>
      <p class="lede">{t('var.risk.caveat').replace('{year}', String(v.risk.census_year))}</p>
      <div class="card pad">
        <dl class="figures">
          {
            figures.map((f) => (
              <div>
                <dt>{f.label}</dt>
                <dd class="mono">{f.value}</dd>
              </div>
            ))
          }
        </dl>
        <dl class="kv printed">
          <dt>{t('var.risk.printed')}</dt>
          <dd>{v.risk.variant_printed}</dd>
          <dt>{t('var.risk.join')}</dt>
          <dd>{t(`join.${v.risk.join}` as UiKey)}</dd>
        </dl>
      </div>
    </div>

    <div>
      <h2>{t('var.localities')}</h2>
      <p class="lede">{t('var.localities.lede')}</p>
      <div class="card scroller">
        <table>
          <thead>
            <tr>
              <th scope="col">{t('var.col.state')}</th>
              <th scope="col" class="num">{t('var.col.municipios')}</th>
              <th scope="col" class="num">{t('var.col.localities')}</th>
            </tr>
          </thead>
          <tbody>
            {
              loc.by_state.map((s) => (
                <tr>
                  <th scope="row">{s.state}</th>
                  <td class="num">{number.format(s.municipios)}</td>
                  <td class="num">{number.format(s.localities)}</td>
                </tr>
              ))
            }
          </tbody>
          <tfoot>
            <tr>
              <th scope="row">{t('var.total')}</th>
              <td class="num">{number.format(loc.municipios)}</td>
              <td class="num">{number.format(loc.localities)}</td>
            </tr>
          </tfoot>
        </table>
      </div>
      {
        loc.localities_without_municipio_code > 0 && (
          <p class="small">{t('var.localities.nocode').replace('{n}', number.format(loc.localities_without_municipio_code))}</p>
        )
      }
      <p class="small">{loc.source}</p>
    </div>
  </section>
</BaseLayout>

<!-- The IPA font is declared here, not in the shared stylesheet, so only
     variant pages reference it and only they download it. The file is a
     subset of Charis SIL built by scripts/build-fonts.mjs. -->
<style is:global>
  @font-face {
    font-family: 'Charis SIL IPA';
    src: url('../assets/fonts/charis-sil-ipa.woff2') format('woff2');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }
  /* Transcriptions only: not autonyms, not surrounding text. */
  .ipa-text {
    font-family: 'Charis SIL IPA', var(--font-sans);
  }
</style>

<style>
  .head {
    padding-top: clamp(20px, 3vw, 32px);
    padding-bottom: 16px;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .crumbs a {
    text-decoration: none;
  }
  .crumbs a:hover {
    text-decoration: underline;
  }
  h1 {
    margin-top: 8px;
    font-size: clamp(30px, 4.2vw, 46px);
    line-height: 1.08;
  }
  .sub {
    margin: 8px 0 0;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 12px;
  }
  h2 {
    font-size: clamp(22px, 2.4vw, 26px);
    line-height: 1.2;
  }
  .lede {
    margin: 4px 0 12px;
    color: var(--ink-muted);
    max-width: 70ch;
  }
  .block {
    margin-top: 32px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .fact,
  .pad {
    padding: 16px 18px;
    min-width: 0;
  }
  .figure {
    margin-top: 4px;
    font-family: var(--font-stat);
    font-size: var(--stat-size);
    font-weight: var(--stat-weight);
    line-height: 1.15;
  }
  .figure.word {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: var(--display-weight);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .risk-swatch.big {
    width: 16px;
    height: 16px;
  }
  .small {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--ink-muted);
  }
  .small-inline {
    display: block;
    font-size: 13px;
    color: var(--ink-muted);
  }
  .kv {
    margin: 10px 0 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 16px;
    font-size: 14px;
  }
  .kv dt {
    color: var(--ink-muted);
  }
  .kv dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .printed {
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--line-soft);
    grid-template-columns: minmax(0, 1fr);
    gap: 2px;
  }
  .printed dd {
    margin-bottom: 8px;
  }
  .figures {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px 20px;
  }
  .figures dt {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .figures dd {
    margin: 2px 0 0;
    font-size: 22px;
    font-weight: 500;
  }
  .mono {
    font-family: var(--font-mono);
  }
  .two {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px 32px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .two {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .scroller {
    position: relative;
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 15px;
  }
  th,
  td {
    padding: 8px 12px;
    text-align: left;
    border-bottom: 1px solid var(--line-soft);
    vertical-align: top;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border-bottom: 1px solid var(--line);
  }
  tbody th {
    font-weight: 500;
  }
  tfoot th,
  tfoot td {
    border-top: 1px solid var(--line);
    border-bottom: 0;
    font-weight: 600;
  }
  .num {
    text-align: right;
    font-family: var(--font-mono);
    font-variant-numeric: tabular-nums;
  }
  .autonym {
    font-size: 17px;
  }
  .alt {
    display: block;
    font-size: 13px;
    font-weight: 400;
    color: var(--ink-muted);
  }
  .ipa {
    font-size: 17px;
    white-space: nowrap;
  }
  /* Marks a transcription that was corrected by hand. */
  .mark {
    font-family: var(--font-mono);
    margin-left: 2px;
  }
  .status {
    font-size: 14px;
    color: var(--ink-muted);
  }
  /* The two statuses that are not a plain extraction read in full ink. */
  .ipa-corrected-by-hand,
  .ipa-in-review {
    color: var(--ink);
  }
  .legend {
    margin: 10px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    font-size: 13px;
    color: var(--ink-muted);
  }
  .legend dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .legend dd {
    margin: 0;
  }
  .font-note {
    margin: 6px 0 0;
    font-size: 12px;
  }
  .font-note a {
    color: var(--ink-muted);
  }
  .sample {
    color: var(--ink);
    margin-right: 4px;
  }
</style>

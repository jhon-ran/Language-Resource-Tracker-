---
// One language group's page, from src/data/groups/<slug>.json.
import BaseLayout from '../layouts/BaseLayout.astro';
import StateValue from './StateValue.astro';
import { useTranslations, localePath, type Locale, type UiKey } from '../i18n/ui';
import { INDICATORS, formatDate, intlLocale, type GroupDetail } from '../lib/indicators';

interface Props {
  locale: Locale;
  slug: string;
}

const { locale, slug } = Astro.props;
const t = useTranslations(locale);

const files = import.meta.glob<{ default: GroupDetail }>('../data/groups/*.json', { eager: true });
const file = files[`../data/groups/${slug}.json`];
if (!file) throw new Error(`no data file for group ${slug}`);
const g = file.default;

const number = new Intl.NumberFormat(intlLocale(locale));
const gradeLabel = (grade: number) => t(`scatter.grade.${grade}` as UiKey);
const stateLabel = (state: string) => t(`state.${state}` as UiKey);
const GRADES = [1, 2, 3, 4] as const;
const byGrade = (grade: number) => g.risk.variants_by_grade[String(grade) as '1' | '2' | '3' | '4'];

const aes = g.indicators.endangerment_status;
const snapshot = formatDate(g.latest_snapshot, locale);
const hasValue = (state: string) => state === 'measured' || state === 'measured-zero';
---

<BaseLayout locale={locale} path={`languages/${g.slug}`} title={g.name}>
  <section class="wrap head">
    <a class="back" href={localePath(locale, 'languages')}>← {t('group.back')}</a>
    <h1>{g.name}</h1>
    <p class="family"><span class="eyebrow">{t('group.family')}</span> {g.family}</p>
  </section>

  <section class="wrap facts">
    <div class="card fact">
      <div class="eyebrow">{t('group.speakers')}</div>
      <div class="figure"><StateValue locale={locale} data={g.speakers} /></div>
      {!hasValue(g.speakers.state) && <p class="state">{stateLabel(g.speakers.state)}</p>}
      <p class="small">{t('group.speakers.source')}</p>
    </div>

    <div class="card fact">
      <div class="eyebrow">{t('group.risk')}</div>
      <div class="figure word">
        <span class="risk-swatch big" style={`background: var(--risk-${g.risk.grade})`}></span>
        {gradeLabel(g.risk.grade)}
      </div>
      <p class="small">{t('group.risk.note')}</p>
      <div class="dist-title eyebrow">{t('group.risk.dist')}</div>
      <div class="dist" aria-hidden="true">
        {
          GRADES.filter((grade) => byGrade(grade) > 0).map((grade) => (
            <span style={`flex-grow: ${byGrade(grade)}; background: var(--risk-${grade})`} />
          ))
        }
      </div>
      <ul class="dist-list">
        {
          GRADES.map((grade) => (
            <li>
              <span class="risk-swatch" style={`background: var(--risk-${grade})`} />
              {gradeLabel(grade)} <span class="mono">{byGrade(grade)}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="card fact">
      <div class="eyebrow">{t('group.aes')}</div>
      <div class="figure word">
        {
          aes.state === 'measured' ? (
            t(`aes.${aes.value}` as UiKey)
          ) : (
            <StateValue locale={locale} data={aes} />
          )
        }
      </div>
      {aes.state !== 'measured' && <p class="state">{stateLabel(aes.state)}</p>}
      <p class="small">{aes.source}</p>
      <p class="small detail">{aes.detail}</p>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="ind-title">
    <h2 id="ind-title">{t('group.indicators')}</h2>
    <p class="lede">{t('group.indicators.lede').replace('{date}', snapshot)}</p>
    <div class="cards">
      {
        INDICATORS.map((ind) => {
          const main = g.indicators[ind.main];
          const raw = ind.raw ? g.indicators[ind.raw] : null;
          return (
            <div class="card ind" style={`--cat: var(--cat-${ind.id})`}>
              <div class="eyebrow">{t(ind.label)}</div>
              <div class="src">{ind.source}</div>
              <div class="figure"><StateValue locale={locale} data={main} /></div>
              <p class="unit">{hasValue(main.state) ? t(ind.unit) : stateLabel(main.state)}</p>
              {raw && hasValue(raw.state) && (
                <p class="small">
                  <span class="mono">{number.format(Number(raw.value))}</span> {t('ind.raw')}
                </p>
              )}
              <dl class="meta">
                <dt>{t('group.source')}</dt>
                <dd>{main.source}</dd>
                <dt>{t('group.detail')}</dt>
                <dd>{main.detail}</dd>
              </dl>
            </div>
          );
        })
      }
    </div>
  </section>

  <section class="wrap block two">
    <div>
      <h2>{t('group.identity')}</h2>
      <div class="card pad">
        <dl class="kv">
          <dt>{t('group.glottocode')}</dt>
          <dd class="mono">{g.identity.glottocode ?? <span class="state-unresolved">{t('group.unresolved')}</span>}</dd>
          <dt>{t('group.iso')}</dt>
          <dd class="mono">{g.identity.iso639_3.length ? g.identity.iso639_3.join(', ') : <span class="state-unresolved">{t('group.none')}</span>}</dd>
          <dt>{t('group.match')}</dt>
          <dd>{t(`match.${g.identity.match_type}` as UiKey)}</dd>
        </dl>
        {
          g.identity.members.length > 0 && (
            <>
              <div class="eyebrow members-title">{t('group.members')}</div>
              <ul class="members">
                {g.identity.members.map((m) => (
                  <li class:list={{ out: m.scope !== 'in-scope' }}>
                    <span class="mono">{m.iso639_3}</span> {m.glottolog_name} <span class="mono muted">{m.glottocode}</span>
                    {m.scope !== 'in-scope' && <span class="muted"> · {m.scope}</span>}
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </div>

    <div>
      <h2>{t('group.variants')} <span class="count mono">{g.variants.length}</span></h2>
      <p class="lede">{t('group.variants.lede')}</p>
      <div class="card scroller">
        <table>
          <thead>
            <tr>
              <th scope="col">{t('group.var.name')}</th>
              <th scope="col">{t('group.var.autonym')}</th>
              <th scope="col">{t('langs.col.risk')}</th>
            </tr>
          </thead>
          <tbody>
            {
              g.variants.map((v) => (
                <tr>
                  <th scope="row">
                    <a href={localePath(locale, `languages/${g.slug}/${v.variant}`)}>{v.spanish_name}</a>
                  </th>
                  <td>{v.autonyms.join(' · ')}</td>
                  <td>
                    <span class="risk">
                      <span class="risk-swatch" style={`background: var(--risk-${v.risk_grade})`} />
                      {gradeLabel(v.risk_grade)}
                    </span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    padding-top: clamp(20px, 3vw, 32px);
    padding-bottom: 16px;
  }
  .back {
    font-size: 14px;
    text-decoration: none;
  }
  .back:hover {
    text-decoration: underline;
  }
  h1 {
    margin-top: 8px;
    font-size: clamp(32px, 4.4vw, 48px);
    line-height: 1.08;
  }
  .family {
    margin: 8px 0 0;
  }
  h2 {
    font-size: clamp(22px, 2.4vw, 26px);
    line-height: 1.2;
  }
  .lede {
    margin: 4px 0 12px;
    color: var(--ink-muted);
    max-width: 70ch;
  }
  .block {
    margin-top: 32px;
  }
  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .fact,
  .pad {
    padding: 16px 18px;
    min-width: 0;
  }
  .figure {
    margin-top: 4px;
    font-family: var(--font-stat);
    font-size: var(--stat-size);
    font-weight: var(--stat-weight);
    line-height: 1.15;
  }
  /* A figure that is a word, not a number. */
  .figure.word {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: var(--display-weight);
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .risk-swatch.big {
    width: 16px;
    height: 16px;
  }
  .small {
    margin: 6px 0 0;
    font-size: 13px;
    color: var(--ink-muted);
  }
  .detail {
    font-family: var(--font-mono);
    font-size: 12px;
    overflow-wrap: anywhere;
  }
  .state,
  .unit {
    margin: 2px 0 0;
    font-size: 14px;
  }
  .dist-title {
    margin-top: 14px;
    font-size: 11px;
  }
  /* Segments are separated by a gap and each keeps the ramp's outline. */
  .dist {
    display: flex;
    gap: 2px;
    height: 12px;
    margin-top: 6px;
  }
  .dist span {
    min-width: 4px;
    border: 1px solid color-mix(in srgb, var(--ink) 60%, transparent);
    border-radius: 2px;
  }
  .dist-list {
    list-style: none;
    margin: 8px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 2px 14px;
    font-size: 13px;
  }
  .dist-list li {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 16px;
  }
  /* The indicator's color as a 4px left border. */
  .ind {
    padding: 14px 16px;
    border-left: var(--cat-border) solid var(--cat);
  }
  .src {
    font-size: 13px;
    color: var(--ink-muted);
  }
  .meta {
    margin: 10px 0 0;
    padding-top: 8px;
    border-top: 1px solid var(--line-soft);
    font-size: 12px;
  }
  .meta dt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-top: 6px;
  }
  .meta dd {
    margin: 0;
    font-family: var(--font-mono);
    color: var(--ink-muted);
    overflow-wrap: anywhere;
  }
  .two {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 24px 32px;
    align-items: start;
  }
  @media (max-width: 900px) {
    .two {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .two h2 {
    margin-bottom: 10px;
  }
  .two h2 + .lede {
    margin-top: -6px;
  }
  .kv {
    margin: 0;
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 16px;
    font-size: 14px;
  }
  .kv dt {
    color: var(--ink-muted);
  }
  .kv dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .members-title {
    margin-top: 14px;
    font-size: 11px;
  }
  .members {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
    font-size: 14px;
    columns: 2 220px;
    column-gap: 24px;
  }
  .members li {
    break-inside: avoid;
    padding: 2px 0;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 0.93em;
  }
  .muted {
    color: var(--ink-muted);
  }
  .count {
    color: var(--ink-muted);
    font-weight: 400;
    font-size: 0.7em;
  }
  /* position: relative keeps the table's visually-hidden labels inside
     the scroll box; without it they widen the whole page. */
  .scroller {
    position: relative;
    overflow-x: auto;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 14px;
  }
  th,
  td {
    padding: 7px 12px;
    text-align: left;
    border-bottom: 1px solid var(--line-soft);
    vertical-align: top;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  thead th {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--ink-muted);
    border-bottom: 1px solid var(--line);
  }
  tbody th {
    font-weight: 500;
  }
  .risk {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }
</style>

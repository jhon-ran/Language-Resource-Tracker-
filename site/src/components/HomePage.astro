---
import BaseLayout from '../layouts/BaseLayout.astro';
import Scatter from './Scatter.astro';
import home from '../data/home.json';
import { useTranslations, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const intlLocale = locale === 'es' ? 'es-MX' : 'en-US';
const number = new Intl.NumberFormat(intlLocale);
const date = new Intl.DateTimeFormat(intlLocale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const reference = home.glottolog_reference_languages;
const stats = [
  { label: t('home.stats.groups'), value: number.format(home.totals.groups), note: t('home.stats.groups.note') },
  { label: t('home.stats.variants'), value: number.format(home.totals.variants), note: t('home.stats.variants.note') },
  {
    label: t('home.stats.reference'),
    // An unmeasured count is shown as a dash, never as zero.
    value: reference.state === 'measured' && reference.value !== null ? number.format(reference.value) : '—',
    note: t('home.stats.reference.note'),
  },
  {
    label: t('home.stats.date'),
    value: date.format(new Date(`${home.latest_snapshot}T00:00:00Z`)),
    note: t('home.stats.date.note'),
    small: true,
  },
];
---

<BaseLayout locale={locale}>
  <section class="wrap hero">
    <div class="intro">
      <div class="eyebrow">{t('home.eyebrow')}</div>
      <h1>{t('home.title')}</h1>
      <p class="lede">{t('home.lede')}</p>
    </div>

    <div class="card stats">
      <div class="eyebrow">{t('home.stats.title')}</div>
      <dl>
        {
          stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd class:list={{ small: s.small }}>{s.value}</dd>
              <dd class="note">{s.note}</dd>
            </div>
          ))
        }
      </dl>
      <p class="principle">{t('home.stats.principle')}</p>
    </div>
  </section>

  <Scatter locale={locale} />
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 32px 48px;
    align-items: start;
    padding-top: clamp(36px, 6vw, 72px);
    padding-bottom: clamp(32px, 5vw, 56px);
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  h1 {
    margin: 16px 0 20px;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.06;
    letter-spacing: -0.01em;
    max-width: 16em;
  }
  .lede {
    margin: 0;
    font-size: 18px;
    color: var(--ink-muted);
    max-width: 34em;
  }
  .stats {
    padding: 28px;
  }
  dl {
    margin: 20px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 24px;
  }
  dt {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
  dd {
    margin: 6px 0 0;
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 500;
    line-height: 1.1;
  }
  dd.small {
    font-size: clamp(20px, 5.4vw, 28px);
    line-height: 1.6;
    white-space: nowrap;
  }
  dd.note {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .principle {
    border-top: 1px solid var(--line);
    margin: 24px 0 0;
    padding-top: 16px;
    font-size: 14px;
    color: var(--ink-muted);
  }
</style>

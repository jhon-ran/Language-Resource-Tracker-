---
import BaseLayout from '../layouts/BaseLayout.astro';
import Scatter from './Scatter.astro';
import home from '../data/home.json';
import Emphasis from './Emphasis.astro';
import { useTranslations, type Locale, localePath } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const intlLocale = locale === 'es' ? 'es-MX' : 'en-US';
const number = new Intl.NumberFormat(intlLocale);
const date = new Intl.DateTimeFormat(intlLocale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });

const reference = home.glottolog_reference_languages;
const stats = [
  { label: t('home.stats.groups'), value: number.format(home.totals.groups), note: t('home.stats.groups.note') },
  { label: t('home.stats.variants'), value: number.format(home.totals.variants), note: t('home.stats.variants.note') },
  {
    label: t('home.stats.reference'),
    // An unmeasured count is shown as a dash, never as zero.
    value: reference.state === 'measured' && reference.value !== null ? number.format(reference.value) : '—',
    note: t('home.stats.reference.note'),
  },
  {
    label: t('home.stats.date'),
    value: date.format(new Date(`${home.latest_snapshot}T00:00:00Z`)),
    note: t('home.stats.date.note'),
    small: true,
  },
];
---

<BaseLayout locale={locale}>
  <section class="wrap hero">
    <div class="intro">
      <div class="eyebrow">{t('home.eyebrow')}</div>
      <h1><Emphasis text={t('home.title')} /></h1>
      <p class="lede">{t('home.lede')}</p>
      <p class="note-term">
        {t('langs.calibration')}{' '}
        <a href={`${localePath(locale, 'method')}#identity`}>{t('langs.calibration.link')}</a>
      </p>
    </div>

    <div class="card stats">
      <div class="eyebrow">{t('home.stats.title')}</div>
      <dl>
        {
          stats.map((s) => (
            <div>
              <dt>{s.label}</dt>
              <dd class:list={{ small: s.small }}>{s.value}</dd>
              <dd class="note">{s.note}</dd>
            </div>
          ))
        }
      </dl>
      <p class="principle">{t('home.stats.principle')}</p>
    </div>
  </section>

  <Scatter locale={locale} />
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 24px 40px;
    align-items: start;
    padding-top: clamp(24px, 3.5vw, 40px);
    padding-bottom: clamp(24px, 3vw, 36px);
  }
  @media (max-width: 900px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  h1 {
    margin: 10px 0 14px;
    font-size: clamp(30px, 4vw, 44px);
    line-height: 1.1;
    letter-spacing: -0.01em;
    max-width: 16em;
  }
  .note-term {
    margin: 10px 0 0;
    font-size: 15px;
    color: var(--ink-muted);
    max-width: 40em;
  }
  .lede {
    margin: 0;
    font-size: 17px;
    color: var(--ink-muted);
    max-width: 36em;
  }
  .stats {
    padding: 18px 20px;
  }
  dl {
    margin: 12px 0 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px 20px;
  }
  dt {
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }
  dd {
    margin: 2px 0 0;
    font-family: var(--font-stat);
    font-size: var(--stat-size);
    font-weight: var(--stat-weight);
    line-height: 1.1;
  }
  dd.small {
    font-family: var(--stat-date-font);
    font-style: var(--stat-date-style);
    font-size: clamp(19px, 5vw, 24px);
    line-height: 1.55;
    white-space: nowrap;
  }
  dd.note {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .principle {
    border-top: 1px solid var(--line);
    margin: 16px 0 0;
    padding-top: 12px;
    font-size: 13px;
    color: var(--ink-muted);
  }
</style>

---
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import { SITE_NAME, locales, useTranslations, localePath, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** This page's path inside its locale, without slashes at the ends. '' is the home page. */
  path?: string;
  /** Page title; the site name is appended. Omit on the home page. */
  title?: string;
}

const { locale, path = '', title } = Astro.props;
const t = useTranslations(locale);
const fullTitle = title ? `${title} · ${SITE_NAME}` : `${SITE_NAME} — ${t('site.tagline')}`;

// Pages that exist get a link; the rest are shown as planned.
const nav = [
  { key: 'nav.home', path: '' },
  { key: 'nav.languages', path: null },
  { key: 'nav.data', path: null },
  { key: 'nav.method', path: null },
] as const;

const sources = ['Glottolog', 'Hugging Face', 'Common Voice', 'Universal Dependencies', 'Omnilingual ASR', 'INEGI', 'INALI'];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={t('footer.about')} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={localePath(l, path)} />)}
    <!-- Apply a stored theme choice before first paint. With no stored
         choice the attribute stays unset and CSS follows the system. -->
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t('skip')}</a>

    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href={localePath(locale)}>
          <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true">
            <rect x="2" y="3" width="10" height="4" fill="var(--accent)"></rect>
            <rect x="2" y="11" width="18" height="4" fill="var(--accent)"></rect>
            <rect x="2" y="19" width="14" height="4" fill="var(--mark-third)"></rect>
          </svg>
          <span>{SITE_NAME}</span>
        </a>

        <nav aria-label={t('nav.label')}>
          <ul>
            {
              nav.map((item) => (
                <li>
                  {item.path === null ? (
                    <span class="planned" title={t('nav.soon')}>
                      {t(item.key)}
                      <span class="visually-hidden"> ({t('nav.soon')})</span>
                    </span>
                  ) : (
                    <a href={localePath(locale, item.path)} aria-current={item.path === path ? 'page' : undefined}>
                      {t(item.key)}
                    </a>
                  )}
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="tools">
        <button type="button" id="theme-toggle" class="theme" aria-pressed="false" aria-label={t('theme.toggle')} title={t('theme.toggle')}>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
            <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
            <path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor"></path>
          </svg>
        </button>
        <div class="lang" role="group" aria-label={t('lang.switch.label')}>
          {
            locales.map((l) => (
              <a href={localePath(l, path)} hreflang={l} lang={l} aria-current={l === locale ? 'true' : undefined}>
                {l.toUpperCase()}
              </a>
            ))
          }
        </div>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap cols">
        <div>
          <div class="name">{SITE_NAME}</div>
          <p>{t('footer.about')}</p>
        </div>
        <div>
          <div class="eyebrow">{t('footer.principle.title')}</div>
          <p>{t('footer.principle.text')}</p>
        </div>
      </div>
      <div class="wrap">
        <p class="sources">{t('footer.sources')}: {sources.join(' · ')}</p>
      </div>
    </footer>
  </body>
</html>

<script>
  // Theme toggle. Default is the system preference; a click overrides it,
  // and clicking back to what the system asks for returns to following it.
  const root = document.documentElement;
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  const button = document.getElementById('theme-toggle');
  const systemTheme = () => (system.matches ? 'dark' : 'light');
  const current = () => root.dataset.theme ?? systemTheme();

  const sync = () => {
    button?.setAttribute('aria-pressed', String(current() === 'dark'));
    // Charts read their colors from the tokens when drawn, so they redraw.
    document.dispatchEvent(new CustomEvent('themechange'));
  };

  button?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    try {
      if (next === systemTheme()) {
        delete root.dataset.theme;
        localStorage.removeItem('theme');
      } else {
        root.dataset.theme = next;
        localStorage.setItem('theme', next);
      }
    } catch {
      // Storage unavailable: the choice still applies to this page view.
      root.dataset.theme = next;
    }
    sync();
  });
  system.addEventListener('change', sync);
  sync();
</script>

<style>
  .skip {
    position: absolute;
    left: -999px;
    top: 0;
    background: var(--ink);
    color: var(--bg);
    padding: 8px 12px;
    z-index: 10;
  }
  .skip:focus {
    left: 8px;
    top: 8px;
  }

  .site-header {
    border-bottom: 1px solid var(--line);
  }
  .bar {
    min-height: 60px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    flex-wrap: wrap;
    padding-top: 8px;
    padding-bottom: 8px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
  }
  nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
    font-size: 15px;
  }
  nav a {
    color: var(--ink);
    text-decoration: none;
    padding: 6px 0;
    display: inline-block;
  }
  nav a:hover {
    color: var(--accent-hover);
  }
  nav a[aria-current='page'] {
    border-bottom: 2px solid var(--accent);
  }
  .planned {
    color: var(--ink-muted);
    padding: 6px 0;
    display: inline-block;
    cursor: default;
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .theme {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 4px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
  }
  .theme:hover {
    border-color: var(--ink-muted);
  }
  .lang {
    display: flex;
    font-family: var(--font-mono);
    font-size: 13px;
    border: 1px solid var(--line);
    border-radius: 4px;
    overflow: hidden;
  }
  .lang a {
    padding: 6px 10px;
    color: var(--ink);
    text-decoration: none;
  }
  .lang a[aria-current='true'] {
    background: var(--ink);
    color: var(--bg);
  }
  @media (max-width: 720px) {
    nav {
      order: 3;
      width: 100%;
    }
  }

  .site-footer {
    margin-top: 44px;
    border-top: 1px solid var(--line);
    padding: 28px 0 24px;
    font-size: 14px;
    color: var(--ink-muted);
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px 48px;
  }
  .cols p {
    margin: 8px 0 0;
    max-width: 46ch;
  }
  .name {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--ink);
  }
  .sources {
    margin: 20px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 12px;
  }
</style>
